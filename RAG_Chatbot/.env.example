# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cloud LLM (reserved for a later phase)
LLM_PROVIDER=openrouter
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=replace-with-model-id

# Retrieval and embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=60
RAG_MIN_CHUNK_TOKENS=24
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_K=30
RAG_HYBRID_ENABLED=false
RAG_RRF_K=60
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MAX_CONTEXT_TOKENS=1800

# Infrastructure (reserved for later phases)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-qdrant-key
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false
PENDING_ACTION_TTL_SECONDS=300
PENDING_ACTION_EXECUTION_LEASE_SECONDS=60
CHAT_RATE_LIMIT_PER_MINUTE=30
CONFIRMATION_RATE_LIMIT_PER_MINUTE=10

# Authentication
# Generate a unique, high-entropy value before any non-development deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional read-only SLAMS integration. Disabled by default; no mock fallback is used when enabled.
SLAMS_ENABLED=false
SLAMS_BASE_URL=http://localhost:8080
SLAMS_CONNECT_TIMEOUT_SECONDS=2
SLAMS_READ_TIMEOUT_SECONDS=5
SLAMS_DELEGATION_ISSUER=agentic-rag-service
SLAMS_DELEGATION_AUDIENCE=slams-internal-api
# PEM private key supplied by the runtime environment; never commit a real key.
SLAMS_DELEGATION_PRIVATE_KEY=replace-with-rs256-private-key
SLAMS_DELEGATION_TOKEN_TTL_SECONDS=300
