# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cloud LLM (reserved for a later phase)
LLM_PROVIDER=openrouter
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=replace-with-model-id

# Infrastructure (reserved for later phases)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-qdrant-key
REDIS_URL=redis://redis:6379/0

# Authentication
# Generate a unique, high-entropy value before any non-development deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
