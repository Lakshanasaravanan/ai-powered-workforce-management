# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: OpenRouter cloud (default) or local Ollama.
LLM_PROVIDER=openrouter
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=replace-with-model-id
LLM_TIMEOUT_SECONDS=30
# Local Ollama is explicitly selected with LLM_PROVIDER=ollama; no secret is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Retrieval and embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# Optional local model cache/offline operation. Leave unset/false for normal development.
EMBEDDING_CACHE_DIR=
EMBEDDING_LOCAL_FILES_ONLY=false
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=60
RAG_MIN_CHUNK_TOKENS=24
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_CANDIDATE_K=30
RAG_HYBRID_ENABLED=false
RAG_RRF_K=60
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CACHE_DIR=
RERANK_LOCAL_FILES_ONLY=false
RAG_MAX_CONTEXT_TOKENS=1800
# Optional local-only index outputs for controlled builds; generated artifacts are not committed.
RAG_RUNTIME_VECTOR_STORE_DIR=
RAG_RUNTIME_SPARSE_INDEX_PATH=

# Infrastructure (reserved for later phases)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_COLLECTION=infotech-policy
VECTOR_STORE_BACKEND=faiss
VECTOR_STORE_DIMENSION=384
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false
PENDING_ACTION_TTL_SECONDS=300
PENDING_ACTION_EXECUTION_LEASE_SECONDS=60
CHAT_RATE_LIMIT_PER_MINUTE=30
CONFIRMATION_RATE_LIMIT_PER_MINUTE=10

# Authentication
# Generate a unique, high-entropy value before any non-development deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVELOPMENT_AUTH_ENABLED=true
# Shared only between the SLAMS server-side assistant proxy and FastAPI; never browser-visible.
ASSISTANT_PROXY_JWT_SECRET=replace-with-separate-assistant-proxy-secret
ASSISTANT_PROXY_ISSUER=slams-assistant-proxy
ASSISTANT_PROXY_AUDIENCE=agentic-rag-assistant

# InfoTech EMS policy-QA identity boundary. The EMS-issued token is validated
# locally, then /api/v1/auth/me supplies current active employee identity.
EMS_JWT_SECRET=replace-with-the-shared-ems-jwt-verification-secret
EMS_JWT_ALGORITHM=HS256
EMS_API_BASE_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:5173
EMS_AUTH_TIMEOUT_SECONDS=3

# Optional read-only SLAMS integration. Disabled by default; no mock fallback is used when enabled.
SLAMS_ENABLED=false
SLAMS_BASE_URL=http://localhost:8080
SLAMS_CONNECT_TIMEOUT_SECONDS=2
SLAMS_READ_TIMEOUT_SECONDS=5
SLAMS_DELEGATION_ISSUER=agentic-rag-service
SLAMS_DELEGATION_AUDIENCE=slams-internal-api
# PEM private key supplied by the runtime environment; never commit a real key.
SLAMS_DELEGATION_PRIVATE_KEY=replace-with-rs256-private-key
SLAMS_DELEGATION_TOKEN_TTL_SECONDS=300
