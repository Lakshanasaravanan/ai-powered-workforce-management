ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://infotech:replace-with-password@localhost:5432/infotech
REDIS_URL=redis://localhost:6379/0
# Generate a local value with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Never commit the generated value. HS256 requires at least 32 bytes.
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
WEBSOCKET_TICKET_TTL_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
